FROM debian:bookworm-slim

# Install Haskell tools and dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ghc \
    cabal-install \
    libghc-quickcheck2-dev \
    ca-certificates \
    pkg-config \
    curl \
 && rm -rf /var/lib/apt/lists/*

# Store Cabal packages outside /root
ENV CABAL_DIR=/opt/cabal

# Configure Cabal
RUN mkdir -p /opt/cabal \
 && printf 'repository hackage.haskell.org\n  url: https://hackage.haskell.org/\n  secure: False\n\nhttp-transport: curl\n' > /opt/cabal/config

# Install FitSpec directly into /opt/cabal
RUN cabal update \
 && cabal install --lib \
      --package-env=/opt/fitspec.env \
      fitspec \
 && chmod -R a+rX /opt/cabal \
 && chmod 644 /opt/fitspec.env

# Use the installed Haskell package environment
ENV GHC_ENVIRONMENT=/opt/fitspec.env

# Execute student code as an unprivileged user
USER 65534:65534

WORKDIR /tmp
