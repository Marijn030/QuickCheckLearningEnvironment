
FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ghc \
    cabal-install \
    libghc-quickcheck2-dev \
    ca-certificates \
    pkg-config \
    curl \
 && rm -rf /var/lib/apt/lists/*

ENV CABAL_DIR=/opt/cabal

RUN mkdir -p /opt/cabal \
 && printf 'repository hackage.haskell.org\n  url: https://hackage.haskell.org/\n  secure: True\n\nhttp-transport: curl\n' > /opt/cabal/config

RUN cabal --version \
 && cabal update \
 && cabal install --lib \
      --package-env=/opt/fitspec.env \
      'fitspec-0.4.10' \
 && chmod -R a+rX /opt/cabal \
 && chmod 644 /opt/fitspec.env

ENV GHC_ENVIRONMENT=/opt/fitspec.env

USER 65534:65534

WORKDIR /tmp
